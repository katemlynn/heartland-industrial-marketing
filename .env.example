# Copy this file to .env.local and fill in real values.
# .env.local is already git-ignored, so your real API key never gets committed.

# Resend API key — from https://resend.com/api-keys (requires a free Resend account)
RESEND_API_KEY=

# Where contact-form / free-audit submissions get emailed to
CONTACT_EMAIL_TO=kate@sittonbuildinggroup.com

# Optional: only set this once you've verified a domain in Resend
# (https://resend.com/domains). Until then, leave it unset and emails
# send from Resend's shared onboarding@resend.dev address, which works
# fine but looks less polished in the recipient's inbox.
# CONTACT_EMAIL_FROM=Heartland Industrial Marketing <leads@heartlandindustrialmarketing.com>
